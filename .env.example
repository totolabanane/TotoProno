PORT=3000
JWT_SECRET=change-moi-en-une-vraie-chaine-aleatoire-longue

# URL de connexion PostgreSQL (Neon). Sur neon.tech : ton projet →
# "Connection string" → copie l'URL complète (commence par postgresql://).
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# URL publique du site (utilisée dans les emails et messages Telegram)
SITE_URL=http://localhost:3000

# --- Notification email (optionnel — si absent, aucun email n'est envoyé) ---
# Fonctionne avec n'importe quel fournisseur SMTP (Brevo, Mailgun, Gmail SMTP...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=APEX PRONOS <notifications@ton-domaine.com>

# --- Notification Telegram (optionnel — si absent, aucun message n'est envoyé) ---
# 1. Crée un bot via @BotFather sur Telegram, récupère le token.
# 2. Ajoute le bot au groupe/canal, récupère son chat_id (ex: via
#    https://api.telegram.org/bot<TOKEN>/getUpdates après avoir envoyé un message).
TELEGRAM_BOT_TOKEN=
# Groupe/canal privé réservé aux abonnés Pro — reçoit le prono en clair (pick + cote + analyse)
TELEGRAM_CHAT_ID_PRO=
# Canal public (optionnel) — reçoit juste une annonce sans le pick, pour donner envie de s'inscrire
TELEGRAM_CHAT_ID_PUBLIC=

# --- Paiement Stripe ---
# Clé secrète de ton compte Stripe (dashboard.stripe.com/apikeys). En mode
# test elle commence par sk_test_, en production par sk_live_.
STRIPE_SECRET_KEY=
# Secret de signature du endpoint webhook (whsec_...), généré quand tu crées
# le endpoint dans dashboard.stripe.com/webhooks (ou via `stripe listen` en local).
STRIPE_WEBHOOK_SECRET=
# IDs des "Price" Stripe (dashboard.stripe.com/products) — PAS les montants
# en clair. STRIPE_PRICE_PRO doit être un prix récurrent mensuel (12€/mois).
# STRIPE_PRICE_SEMAINE doit être un prix ponctuel/one-time (7€).
STRIPE_PRICE_PRO=
STRIPE_PRICE_SEMAINE=
